{
  "name": "snello",
  "displayName": "Snello",
  "description": "Snello language support for Visual Studio Code: errors as you type, navigation and tests",
  "version": "0.0.1",
  "publisher": "snello-lang",
  "license": "BSD-3-Clause",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1C1915",
    "theme": "dark"
  },
  "keywords": [
    "snello",
    "syntax",
    "highlighting",
    "language server",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/snello-lang/vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the folder cannot choose the snello command, and no test is run.",
      "restrictedConfigurations": [
        "snello.serverPath",
        "snello.backend"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "snello",
        "aliases": [
          "Snello",
          "snello"
        ],
        "extensions": [
          ".snello"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "snello.mod",
        "aliases": [
          "Snello Module File"
        ],
        "filenames": [
          "snello.mod"
        ],
        "configuration": "./language-configuration.mod.json"
      },
      {
        "id": "snello.lock",
        "aliases": [
          "Snello Lock File"
        ],
        "filenames": [
          "snello.lock"
        ]
      }
    ],
    "grammars": [
      {
        "language": "snello",
        "scopeName": "source.snello",
        "path": "./syntaxes/snello.tmLanguage.json"
      },
      {
        "language": "snello.mod",
        "scopeName": "source.snello.mod",
        "path": "./syntaxes/snello.mod.tmLanguage.json"
      },
      {
        "language": "snello.lock",
        "scopeName": "source.snello.lock",
        "path": "./syntaxes/snello.lock.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Snello",
      "properties": {
        "snello.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The absolute path of the `snello` command the language server runs as `snello lsp`. Empty, the first `snello` on the `PATH`."
        },
        "snello.backend": {
          "type": "string",
          "enum": [
            "",
            "llvm",
            "c"
          ],
          "default": "",
          "markdownDescription": "The backend tests are built through, `llvm` or `c`; empty, the `snello` command's default."
        }
      }
    },
    "commands": [
      {
        "command": "snello.restartServer",
        "title": "Restart Language Server",
        "category": "Snello"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.1"
  },
  "activationEvents": [
    "workspaceContains:**/snello.mod",
    "workspaceContains:**/*.snello",
    "onCommand:snello.restartServer"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
