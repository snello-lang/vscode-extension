{
  "name": "snello",
  "displayName": "Snello",
  "description": "Snello language support for Visual Studio Code",
  "version": "0.0.1",
  "publisher": "snello-lang",
  "license": "BSD-3-Clause",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1C1915",
    "theme": "dark"
  },
  "keywords": [
    "snello",
    "syntax",
    "highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/snello-lang/vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "snello",
        "aliases": [
          "Snello",
          "snello"
        ],
        "extensions": [
          ".snello"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "snello",
        "scopeName": "source.snello",
        "path": "./syntaxes/snello.tmLanguage.json"
      }
    ]
  }
}
